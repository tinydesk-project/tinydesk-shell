tdsh_console_access.h: enum { TDSH_ACCESS_LOCAL, TDSH_ACCESS_RECOVERY, TDSH_ACCESS_REMOTE };
tdsh_console_access.h: typedef atomic_int tdsh_console_access_t;
tdsh_console_access.h: static inline bool tdsh_access_is_physical(tdsh_console_access_t *access) { return atomic_load(access) != TDSH_ACCESS_REMOTE; } static inline bool tdsh_access_begin_recovery(tdsh_console_access_t *access) { int expected = TDSH_ACCESS_LOCAL; return atomic_compare_exchange_strong(access, &expected, TDSH_ACCESS_RECOVERY); } static inline void tdsh_access_end_recovery(tdsh_console_access_t *access) { int expected = TDSH_ACCESS_RECOVERY; (void)atomic_compare_exchange_strong(access, &expected, TDSH_ACCESS_LOCAL); } static inline bool tdsh_access_mark_remote(tdsh_console_access_t *access) { int expected = TDSH_ACCESS_LOCAL; return atomic_compare_exchange_strong(access, &expected, TDSH_ACCESS_REMOTE) || expected == TDSH_ACCESS_REMOTE; }
